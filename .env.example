# Gere uma chave forte e única, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# A aplicação NÃO inicia se esta chave for o valor padrão.
SECRET_KEY=troque-esta-chave

# Banco de dados
DB_USER=kartrack
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-a-senha-root
DB_HOST=db
DB_PORT=3306
DB_NAME=kartrack

# Origens permitidas para CORS (separadas por vírgula). Use o domínio real em produção.
# Ex.: CORS_ORIGINS=https://seu.dominio.com
CORS_ORIGINS=http://localhost:5173

# Tamanho máximo de upload de imagem em bytes (padrão 5 MB)
MAX_UPLOAD_BYTES=5242880
