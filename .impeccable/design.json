    {
      "name": "Botão primário",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Único bloco de violeta Perfil — ação que grava (Salvar, Abastecer).",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Abastecer</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 14px;border-radius:10px;border:1px solid var(--accent,#9184d9);background:var(--accent,#9184d9);color:var(--on-accent,#16181c);font:700 1rem/1.2 Chivo,system-ui,sans-serif;cursor:pointer;transition:transform 120ms cubic-bezier(0.22,1,0.36,1),box-shadow 180ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary:hover{box-shadow:0 0 0 3px var(--accent-glow,rgba(181,171,252,.38))}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}"
    },
    {
      "name": "Botão default",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Ação secundária em placa-2 com costura; hover aquece a borda.",
      "html": "<button class=\"ds-btn\" type=\"button\">Cancelar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 14px;border-radius:10px;border:1px solid var(--border,#353941);background:var(--panel-2,#26292f);color:var(--text,#e7e8ea);font:500 1rem/1.2 Chivo,system-ui,sans-serif;cursor:pointer;transition:border-color 180ms cubic-bezier(0.22,1,0.36,1),transform 120ms cubic-bezier(0.22,1,0.36,1)}.ds-btn:hover{border-color:color-mix(in srgb,var(--accent,#9184d9) 45%,var(--border,#353941))}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}"
    },
    {
      "name": "Botão ghost",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Mesma caixa, fundo transparente — tema, ícone, ações terciárias.",
      "html": "<button class=\"ds-btn-ghost\" type=\"button\" aria-label=\"Tema\">☀</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:0;border-radius:10px;border:1px solid var(--border,#353941);background:transparent;color:var(--text,#e7e8ea);cursor:pointer}.ds-btn-ghost:hover{border-color:color-mix(in srgb,var(--accent,#9184d9) 45%,var(--border,#353941))}.ds-btn-ghost:active{transform:scale(.9)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}"
    },
