      "description": "Exclusão e destrutivo — vermelho semântico, nunca marca.",
      "html": "<button class=\"ds-btn-danger\" type=\"button\">Excluir</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 14px;border-radius:10px;border:1px solid color-mix(in srgb,var(--danger,#e24b4a) 55%,var(--border,#353941));background:var(--danger-dim,rgba(226,75,74,.16));color:var(--danger,#e24b4a);font:500 1rem/1.2 Chivo,system-ui,sans-serif;cursor:pointer}.ds-btn-danger:active{transform:scale(.97)}.ds-btn-danger:focus-visible{outline:2px solid var(--accent,#9184d9);outline-offset:2px}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Field 44px com label muted acima; foco = borda Perfil + glow 3px.",
      "html": "<label class=\"ds-field\">Odômetro (km)<input class=\"ds-input\" type=\"text\" placeholder=\"128450\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:600 .875rem/1.3 Chivo,system-ui,sans-serif;color:var(--muted,#9aa1ab)}.ds-input{width:100%;min-height:44px;padding:8px 12px;border:1px solid var(--border,#353941);border-radius:10px;background:color-mix(in srgb,var(--panel,#202329) 70%,var(--bg,#16181c));color:var(--text,#e7e8ea);font:400 1rem/1.5 Chivo,system-ui,sans-serif}.ds-input:focus{border-color:var(--accent,#9184d9);box-shadow:0 0 0 3px var(--accent-glow,rgba(181,171,252,.38));outline:none}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Placa 14px, costura 1px, sem sombra em repouso.",
      "html": "<article class=\"ds-card\"><strong>Registros</strong><p>CSV e edição em massa ficam nesta placa.</p></article>",
      "css": ".ds-card{background:var(--panel,#202329);color:var(--text,#e7e8ea);border:1px solid var(--border,#353941);border-radius:14px;padding:16px;font:400 1rem/1.5 Chivo,system-ui,sans-serif}.ds-card strong{display:block;font-weight:600;letter-spacing:-.02em;margin-bottom:8px}.ds-card p{margin:0;color:var(--muted,#9aa1ab)}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill para badge/estado; lookups de cadastro não usam chip.",
      "html": "<span class=\"ds-chip\">Tanque cheio</span><span class=\"ds-badge\">FIPE</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:999px;border:1px solid var(--border,#353941);background:var(--panel-2,#26292f);font:400 .875rem/1.2 Chivo,system-ui,sans-serif;color:var(--text,#e7e8ea);margin-right:8px}.ds-badge{display:inline-flex;padding:2px 8px;border-radius:999px;font:700 .72rem/1.2 Chivo,system-ui,sans-serif;letter-spacing:.04em;text-transform:uppercase;color:var(--accent,#9184d9);border:1px solid color-mix(in srgb,var(--accent,#9184d9) 50%,var(--border,#353941));background:var(--accent-dim,rgba(145,132,217,.16))}"
    },
    {
      "name": "Rail ativo",
      "kind": "nav",
      "refersTo": "nav-rail-active",
